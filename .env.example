# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://zmvdkzphpjjcwwrnniuu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Used only in server code and Edge Functions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (mapbox.com -> Account -> Tokens) ---
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# --- Notifications (post-MVP / Phase 6) ---
EMAIL_FROM=no-reply@nextstep.example
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
